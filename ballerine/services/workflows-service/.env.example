BCRYPT_SALT=10
COMPOSE_PROJECT_NAME=ballerine-x
PORT=3000
DB_USER=admin
DB_PASSWORD=CHANGEME_SET_PASSWORD
DB_PORT=5432
DB_URL=postgres://admin:CHANGEME_SET_PASSWORD@localhost:5432/postgres
SESSION_SECRET=CHANGEME_SET_SECRET
SESSION_EXPIRATION_IN_MINUTES=60
WORKFLOW_DASHBOARD_CORS_ORIGIN=http://localhost:5200
BACKOFFICE_CORS_ORIGIN=http://localhost:5137
KYB_EXAMPLE_CORS_ORIGIN=http://localhost:5201
KYC_EXAMPLE_CORS_ORIGIN=http://localhost:5202
API_KEY=CHANGEME_SET_API_KEY
NODE_ENV=development
ENVIRONMENT_NAME=local
SENTRY_DSN=
EMAIL_API_TOKEN=
EMAIL_API_URL=
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET_KEY=
AWS_S3_BUCKET_SECRET=
AWS_REGION=
ADMIN_API_KEY=CHANGEME_SET_ADMIN_SECRET
MAIL_ADAPTER=log
UNIFIED_API_URL=http://localhost:3001
UNIFIED_API_TOKEN=CHANGEME_SET_UNIFIED_TOKEN
UNIFIED_API_SHARED_SECRET=CHANGEME_SET_SHARED_SECRET
SALESFORCE_API_VERSION=58.0
SALESFORCE_CONSUMER_KEY=
SALESFORCE_CONSUMER_SECRET=
APP_API_URL=http://localhost:3000
COLLECTION_FLOW_URL=http://localhost:5201
WEB_UI_SDK_URL=http://localhost:5202
#HASHING_KEY_SECRET="$2b$10$FovZTB91/QQ4Yu28nvL8e."
NOTION_API_KEY=CHANGEME_SET_NOTION_KEY
HASHING_KEY_SECRET_BASE64=CHANGEME_SET_HASHING_KEY
SECRETS_MANAGER_PROVIDER=in-memory
SYNC_UNIFIED_API=false
MAGIC_LINK_AUTH_JWT_SECRET=CHANGEME_SET_MAGIC_LINK_SECRET
# JWT Configuration - Must match backend JWT_SECRET
JWT_SECRET=CHANGEME_SET_JWT_SECRET
JWT_ISSUER=thaliumx-platform
JWT_AUDIENCE=thaliumx-api
# Optional JWT security controls
# JWT_ALLOWED_ROLES=platform_admin,broker_admin,user_trader,user_viewer
# JWT_ALLOWED_EMAIL_DOMAINS=thaliumx.com,example.com
# JWT_REQUIRE_ADMIN_APPROVAL=false
# JWT_USER_CREATION_RATE_LIMIT=5
# Security settings - Set to true in production to prevent XSS/CSRF attacks
SESSION_HTTP_ONLY=false
# Options: false, true, 'lax', 'strict', 'none'
SESSION_SAME_SITE=strict
# Set to true in production to ensure cookies are only sent over HTTPS
SESSION_SECURE_COOKIE=false
# Enable if your app is behind a secure proxy
SESSION_SECURE_PROXY=false
# Optional redis connection
REDIS_PASSWORD=CHANGEME_SET_REDIS_PASSWORD
REDIS_HOST=localhost
REDIS_PORT=6379
# Queue system settings
QUEUE_SYSTEM_ENABLED=false
IS_QUEUE_WORKER=false
