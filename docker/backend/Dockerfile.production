# =============================================================================
# ThaliumX Backend Production Dockerfile
# - Builds TypeScript inside the image so runtime always includes latest src changes
# - Keeps the final runtime image hardened and small
# =============================================================================

# -----------------------------------------------------------------------------
# Build stage (TypeScript -> dist)
# -----------------------------------------------------------------------------
FROM node:20.18.0-alpine AS builder

WORKDIR /build/backend

# Copy package manifests first (better layer caching)
COPY docker/backend/package.json ./
COPY docker/backend/package-lock.json ./

# Shared package (backend depends on file:./shared)
COPY docker/shared/package.json ./shared/
COPY docker/shared/dist ./shared/dist

# Install deps including devDeps for TypeScript compilation.
# NOTE: we keep --ignore-scripts for consistency with existing hardening.
RUN npm install --include=dev --ignore-scripts && npm cache clean --force

# Copy TypeScript sources and compile
COPY docker/backend/tsconfig.json ./
COPY docker/backend/src ./src

RUN npm run build

# -----------------------------------------------------------------------------
# Runtime stage
# -----------------------------------------------------------------------------
FROM node:20.18.0-alpine

# Security: Update packages and install runtime dependencies
RUN apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache \
      libc6-compat \
      dumb-init \
      curl \
      su-exec \
    && rm -rf /var/cache/apk/*

# Security: Create non-root user with specific UID/GID
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs thaliumx

# Set working directory
WORKDIR /app

# Security: Create necessary directories with proper permissions
RUN mkdir -p /app/dist /app/shared /app/node_modules /app/logs /app/.secrets && \
    chown -R thaliumx:nodejs /app

# Copy package files and install production dependencies
COPY --chown=thaliumx:nodejs docker/backend/package.json ./
COPY --chown=thaliumx:nodejs docker/backend/package-lock.json ./
COPY --chown=thaliumx:nodejs docker/shared/package.json ./shared/

# Install production dependencies only
RUN npm install --only=production --ignore-scripts && npm cache clean --force

# Copy built artifacts from builder stage
COPY --from=builder --chown=thaliumx:nodejs /build/backend/dist ./dist
COPY --from=builder --chown=thaliumx:nodejs /build/backend/shared/dist ./shared/dist

# Security: Set default environment (can be overridden)
ENV PORT=3002

# Security: Disable npm update checks and telemetry
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV NO_UPDATE_NOTIFIER=1

# Expose port (non-privileged)
EXPOSE 3002

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:3002/health || exit 1

# Security: Switch to non-root user
USER thaliumx

# Security: Use dumb-init to handle signals properly (PID 1 zombie reaping)
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start the application
CMD ["node", "dist/index.js"]

# Security Labels
LABEL org.opencontainers.image.title="ThaliumX Backend"
LABEL org.opencontainers.image.description="ThaliumX Backend API Service"
LABEL security.hardened="true"
LABEL security.non-root="true"
