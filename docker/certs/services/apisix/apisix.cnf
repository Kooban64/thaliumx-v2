[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = US
ST = CA
L = SanFrancisco
O = ThaliumX
OU = production
CN = thaliumx-apisix

[req_ext]
subjectAltName = DNS:thaliumx-apisix,DNS:apisix,DNS:localhost,DNS:*.thaliumx.com,IP:127.0.0.1
