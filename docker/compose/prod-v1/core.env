# ThaliumX Core Services Environment (TEMPLATE)
# Copy to docker/core/core.env locally.
# NEVER commit real secrets. Provide secrets via Vault / docker secrets / CI variables.

# ===================
# RUNTIME
# ===================
NODE_ENV=production
PORT=3002

# ===================
# FRONTEND
# ===================
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_URL=https://thaliumx.com
NEXT_PUBLIC_WS_URL=wss://thaliumx.com
# Temporary workaround: serve Keycloak under the main hostname to avoid relying on auth.thaliumx.com DNS.
NEXT_PUBLIC_KEYCLOAK_URL=https://thaliumx.com/auth
NEXT_PUBLIC_KEYCLOAK_REALM=thaliumx-platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=thaliumx-frontend

# ===================
# BACKEND - REQUIRED
# ===================
ALLOWED_ORIGINS=https://thaliumx.com,https://thal.thaliumx.com

DB_HOST=postgres
DB_PORT=5432
DB_NAME=thaliumx
DB_USER=thaliumx
DB_PASSWORD=CHANGEME__SET_VIA_SECRETS
DB_SSL=true

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=CHANGEME__SET_VIA_SECRETS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=thaliumx
JWT_AUDIENCE=thaliumx-users

ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=CHANGEME__SET_VIA_SECRETS

KEYCLOAK_URL=https://keycloak:8443
KEYCLOAK_REALM=thaliumx-platform
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

KAFKA_BROKERS=kafka:9092
KAFKA_SSL=false

MONGODB_URI=
TYPESENSE_URL=
TYPESENSE_API_KEY=
OPA_URL=http://opa:8181

# Metrics (optional)
METRICS_TOKEN=
INTERNAL_REQUEST_TOKEN=
# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=thaliumx@example.com
SMTP_PASSWORD=dummy-smtp-password-for-production
