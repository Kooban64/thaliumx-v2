# Trading Services Environment Variables
# ======================================
# Default passwords for initial testing
# In production, these should be set via secure environment variables

POSTGRES_PASSWORD=CHANGEME__SET_VIA_SECRETS
REDIS_PASSWORD=CHANGEME__SET_VIA_SECRETS
MONGO_INITDB_ROOT_PASSWORD=CHANGEME__SET_VIA_SECRETS

# Kafka Configuration
KAFKA_BROKERS=thaliumx-kafka:9092

# Logging
RUST_LOG=info
LOG_LEVEL=INFO

# Dingir Configuration
RUN_MODE=production
DINGIR_PERSIST_TO_MQ=false

# Vault Configuration (if needed)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=CHANGEME__SET_VIA_SECRETS