# Wazuh SIEM Configuration
# These values should be moved to Vault / docker secrets in production.
#
# IMPORTANT:
# - Passwords MUST match the bcrypt hashes in
#   [`docker/wazuh/config/wazuh_indexer/internal_users.yml`](docker/wazuh/config/wazuh_indexer/internal_users.yml:1)
# - `DASHBOARD_USERNAME/PASSWORD` are *not* the UI login; they are written into
#   the OpenSearch Dashboards keystore as `opensearch.username/password` by the
#   image entrypoint.

# Wazuh Indexer (OpenSearch) credentials
INDEXER_USERNAME=admin
INDEXER_PASSWORD=ThaliumX_Indexer_Admin_2025!

# Wazuh Manager API credentials (dashboard -> manager)
API_USERNAME=wazuh-wui
API_PASSWORD=ThaliumX_WazuhAPI_2025!

# OpenSearch Dashboards service user (dashboard -> indexer)
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=ThaliumX_Dashboards_2025!
