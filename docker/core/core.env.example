# ThaliumX Core Services Environment (TEMPLATE)
# Copy to docker/core/core.env locally.
# NEVER commit real secrets. Provide secrets via Vault / docker secrets / CI variables.

# ===================
# RUNTIME
# ===================
NODE_ENV=production
PORT=3002

# ===================
# FRONTEND
# ===================
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WS_URL=wss://api.example.com
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.example.com
NEXT_PUBLIC_KEYCLOAK_REALM=thaliumx
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=thaliumx-frontend

# ===================
# BACKEND - REQUIRED
# ===================
ALLOWED_ORIGINS=https://app.example.com

DB_HOST=postgres
DB_PORT=5432
DB_NAME=thaliumx
DB_USER=thaliumx
DB_PASSWORD=
DB_SSL=true

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=thaliumx
JWT_AUDIENCE=thaliumx-users

ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=thaliumx
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

KAFKA_BROKERS=kafka:9092
KAFKA_SSL=false

MONGODB_URI=
TYPESENSE_URL=
TYPESENSE_API_KEY=
OPA_URL=http://opa:8181

# Metrics (optional)
METRICS_TOKEN=
INTERNAL_REQUEST_TOKEN=
