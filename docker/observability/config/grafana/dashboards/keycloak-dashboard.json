{
  "dashboard": {
    "id": null,
    "title": "Keycloak Identity Management",
    "tags": ["thaliumx", "keycloak", "identity", "security"],
    "timezone": "UTC",
    "panels": [
      {
        "id": 1,
        "title": "Keycloak JVM Memory",
        "type": "graph",
        "targets": [
          {
            "expr": "jvm_memory_bytes_used{job=\"keycloak\"}",
            "legendFormat": "Used Memory"
          },
          {
            "expr": "jvm_memory_bytes_max{job=\"keycloak\"}",
            "legendFormat": "Max Memory"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Keycloak HTTP Requests",
        "type": "graph",
        "targets": [
          {
            "expr": "http_server_requests_seconds_count{job=\"keycloak\"}",
            "legendFormat": "Total Requests"
          },
          {
            "expr": "http_server_requests_seconds_count{job=\"keycloak\",status=\"500\"}",
            "legendFormat": "5xx Errors"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Active User Sessions",
        "type": "stat",
        "targets": [
          {
            "expr": "keycloak_user_sessions_active{job=\"keycloak\"}",
            "legendFormat": "Active Sessions"
          }
        ],
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Login Attempts",
        "type": "graph",
        "targets": [
          {
            "expr": "keycloak_logins_total{job=\"keycloak\"}",
            "legendFormat": "Total Logins"
          },
          {
            "expr": "keycloak_login_errors_total{job=\"keycloak\"}",
            "legendFormat": "Login Errors"
          }
        ],
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 8}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}