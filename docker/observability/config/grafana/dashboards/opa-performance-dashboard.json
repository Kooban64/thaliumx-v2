{
  "dashboard": {
    "id": null,
    "title": "OPA Performance Dashboard",
    "tags": ["opa", "policy", "performance", "authorization"],
    "timezone": "UTC",
    "panels": [
      {
        "id": 1,
        "title": "OPA Evaluation Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(opa_evaluation_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(opa_evaluation_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile"
          },
          {
            "expr": "histogram_quantile(0.99, rate(opa_evaluation_duration_seconds_bucket[5m]))",
            "legendFormat": "99th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Cache Hit Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(opa_cache_hits_total[5m]) / (rate(opa_cache_hits_total[5m]) + rate(opa_cache_misses_total[5m])) * 100",
            "legendFormat": "Cache Hit Rate %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "WASM vs HTTP Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(opa_wasm_evaluations_total[5m])",
            "legendFormat": "WASM Evaluations"
          },
          {
            "expr": "rate(opa_http_evaluations_total[5m])",
            "legendFormat": "HTTP Evaluations"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Evaluations by Policy Type",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(opa_evaluations_total[5m])) by (policy_type)",
            "legendFormat": "{{policy_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Cache Hits by Level",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(opa_cache_hits_total[5m])) by (cache_level, policy_type)",
            "legendFormat": "{{policy_type}} - {{cache_level}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Evaluation Results",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(opa_evaluations_total[5m])) by (result)",
            "legendFormat": "{{result}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 7,
        "title": "Total Evaluations (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(opa_evaluations_total[24h]))",
            "legendFormat": "Total Evaluations"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24}
      },
      {
        "id": 8,
        "title": "Cache Hit Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(opa_cache_hits_total[5m])) / (sum(rate(opa_cache_hits_total[5m])) + sum(rate(opa_cache_misses_total[5m]))) * 100",
            "legendFormat": "Hit Rate %"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 24}
      },
      {
        "id": 9,
        "title": "WASM Usage %",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(opa_wasm_evaluations_total[5m])) / (sum(rate(opa_wasm_evaluations_total[5m])) + sum(rate(opa_http_evaluations_total[5m]))) * 100",
            "legendFormat": "WASM %"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 24}
      },
      {
        "id": 10,
        "title": "Avg Latency (ms)",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(rate(opa_evaluation_duration_seconds_sum[5m]) / rate(opa_evaluation_duration_seconds_count[5m])) * 1000",
            "legendFormat": "Avg Latency"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 24}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
