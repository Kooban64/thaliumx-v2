{
  "dashboard": {
    "id": null,
    "title": "ThaliumX System Overview",
    "tags": ["thaliumx", "overview", "system", "health"],
    "timezone": "UTC",
    "panels": [
      {
        "id": 1,
        "title": "Service Health Status",
        "type": "table",
        "targets": [
          {
            "expr": "up{job=~\"thaliumx-.*\"}",
            "legendFormat": "{{job}}"
          }
        ],
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "System Resource Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU Usage %"
          },
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "legendFormat": "Memory Usage %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "API Response Times",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"thaliumx-backend\"}[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"thaliumx-backend\"}[5m]))",
            "legendFormat": "50th percentile"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
      },
      {
        "id": 4,
        "title": "Error Rates",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"thaliumx-backend\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"thaliumx-backend\"}[5m]) * 100",
            "legendFormat": "5xx Error Rate %"
          },
          {
            "expr": "rate(http_requests_total{job=\"thaliumx-backend\",status=~\"4..\"}[5m]) / rate(http_requests_total{job=\"thaliumx-backend\"}[5m]) * 100",
            "legendFormat": "4xx Error Rate %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
      },
      {
        "id": 5,
        "title": "Trading Volume",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(trade_volume_total[5m]))",
            "legendFormat": "Volume (24h)"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 14}
      },
      {
        "id": 6,
        "title": "Active Users",
        "type": "stat",
        "targets": [
          {
            "expr": "active_users_total",
            "legendFormat": "Active Users"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 14}
      },
      {
        "id": 7,
        "title": "Compliance Events",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(compliance_events_total)",
            "legendFormat": "Total Events"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 14}
      },
      {
        "id": 8,
        "title": "System Uptime",
        "type": "stat",
        "targets": [
          {
            "expr": "nodejs_uptime_seconds",
            "legendFormat": "Uptime (seconds)"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 14}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}