{
  "alerts": [
    {
      "name": "High Error Rate",
      "condition": "sum(rate({service=\"thaliumx-backend\", level=\"error\"}[5m])) > 0.01",
      "message": "Error rate exceeds 1% of total requests",
      "severity": "critical"
    },
    {
      "name": "Missing Audit Logs",
      "condition": "count({service=\"thaliumx-backend\"} |= \"Audit Event\" [1h]) == 0",
      "message": "No audit logs generated in the last hour - compliance violation",
      "severity": "critical"
    },
    {
      "name": "Log Shipping Failure",
      "condition": "up{job=\"promtail\"} == 0",
      "message": "Promtail is down - logs not being shipped to Loki",
      "severity": "high"
    },
    {
      "name": "Disk Space Low",
      "condition": "node_filesystem_avail_bytes{mountpoint=\"/var/log\"} / node_filesystem_size_bytes{mountpoint=\"/var/log\"} < 0.1",
      "message": "Log disk space below 10%",
      "severity": "high"
    },
    {
      "name": "PII Leakage Detected",
      "condition": "count({service=\"thaliumx-backend\"} |~ \"password.*[^REDACTED]\" |~ \"apiKey.*[^REDACTED]\") > 0",
      "message": "Potential PII leakage detected in logs",
      "severity": "critical"
    },
    {
      "name": "Log Integrity Failure",
      "condition": "count({service=\"thaliumx-backend\"} |= \"Integrity verification failed\") > 0",
      "message": "Log integrity verification failed - possible tampering",
      "severity": "critical"
    },
    {
      "name": "High Log Volume",
      "condition": "sum(rate({service=\"thaliumx-backend\"}[5m])) > 10000",
      "message": "Log volume exceeds 10,000 logs/second",
      "severity": "medium"
    },
    {
      "name": "Compliance Violation",
      "condition": "count({service=\"thaliumx-backend\"} |= \"compliance violation\") > 0",
      "message": "Compliance violation detected",
      "severity": "critical"
    }
  ]
}
