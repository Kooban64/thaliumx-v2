# ===========================================
# ThaliumX Production Environment Template
# ===========================================
# IMPORTANT:
# - This template contains placeholder values that MUST be replaced
# - Do NOT use these placeholder values in production
# - Generate new secrets using: docker/scripts/generate-production-secrets.sh
# - Store secrets in Vault or use Docker secrets for production deployment

NODE_ENV=production
PORT=3002

# ===================
# DATABASE - SSL REQUIRED
# ===================
# DB_SSL MUST be true in production
DB_SSL=true
POSTGRES_HOST=thaliumx-postgres
POSTGRES_PORT=5432
POSTGRES_USER=thaliumx
POSTGRES_PASSWORD=SET_IN_VAULT  # REQUIRED - Strong password (min 16 chars, complex)
POSTGRES_DB=thaliumx
DATABASE_URL=postgresql://thaliumx:SET_IN_VAULT@thaliumx-postgres:5432/thaliumx?ssl=true&sslmode=require

# ===================
# REDIS - SSL REQUIRED
# ===================
REDIS_URL=rediss://:SET_IN_VAULT@thaliumx-redis:6379?ssl=true
REDIS_HOST=thaliumx-redis
REDIS_PORT=6379
REDIS_PASSWORD=SET_IN_VAULT  # REQUIRED - Strong password (min 16 chars)

# ===================
# MONGODB - SSL REQUIRED
# ===================
MONGODB_URL=mongodb://thaliumx:SET_IN_VAULT@thaliumx-mongodb:27017/thaliumiumx?authSource=thaliumx&tls=true&tlsCertificateKeyFile=/etc/mongodb/SSL/mongodb.pem
MONGODB_HOST=thaliumx-mongodb
MONGODB_PORT=27017
MONGODB_USER=thaliumx
MONGODB_PASSWORD=SET_IN_VAULT  # REQUIRED - Strong password (min 16 chars)
MONGODB_DB=thaliumx

# ===================
# JWT & SECURITY - CRITICAL
# ===================
# REQUIRED - Generate 64+ character random string
JWT_SECRET=SET_IN_VAULT_64_CHAR_MINIMUM
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=thaliumx
JWT_AUDIENCE=thaliumx-users

# REQUIRED - Generate 64+ character random string (for AES-256-GCM)
ENCRYPTION_KEY=SET_IN_VAULT_64_CHAR_MINIMUM

# Internal API authentication
# REQUIRED - Generate 32+ character random string
INTERNAL_REQUEST_TOKEN=SET_IN_VAULT_32_CHAR_MINIMUM

# Metrics endpoint authentication
# REQUIRED - Generate 32+ character random string
METRICS_TOKEN=SET_IN_VAULT_32_CHAR_MINIMUM

# ===================
# KEYCLOAK / OIDC (Authentik)
# ===================
THALIUMX_AUTH_PROVIDER=Authentik
AUTHENTIK_ISSUER=https://auth.thaliumx.com/auth/realms/thaliumx
AUTHENTIK_JWKS_URI=https://auth.thaliumx.com/auth/realms/thaliumx/protocol/openid-connect/certs
AUTHENTIK_AUDIENCE=thaliumx-backend

# ===================
# VAULT
# ===================
VAULT_ADDR=https://thaliumx-vault:8200
VAULT_TOKEN=SET_IN_VAULT  # REQUIRED - Vault token with appropriate policies
VAULT_SKIP_VERIFY=false
VAULT_CACERT=/etc/vault/tls/ca.crt

# ===================
# KAFKA - SSL REQUIRED
# ===================
KAFKA_BROKERS=thaliumx-kafka:9094
KAFKA_CLIENT_ID=thaliumx-backend
KAFKA_GROUP_ID=thaliumx-group
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=thaliumx-kafka
KAFKA_SASL_PASSWORD=SET_IN_VAULT  # REQUIRED

# ===================
# BLNKFINANCE / TYPESENSE
# ===================
BLNK_FINANCE_URL=https://thaliumx-blnkfinance:5001
BLNK_SECRET_KEY=SET_IN_VAULT  # REQUIRED - Get from blnkfinance deployment
TYPESENSE_URL=https://thaliumx-typesense:8108
TYPESENSE_API_KEY=SET_IN_VAULT  # REQUIRED - 32+ char random string

# ===================
# BALLERINE KYC
# ===================
BALLERINE_URL=https://thaliumx-ballerine-workflow:3000
BALLERINE_API_KEY=SET_IN_VAULT  # REQUIRED
BALLERINE_WEBHOOK_SECRET=SET_IN_VAULT  # REQUIRED

# ===================
# TRADING ENGINE
# ===================
DINGIR_GRPC_URL=grpcs://thaliumx-dingir-matchengine:50051
DINGIR_REST_URL=https://thaliumx-dingir-restapi:8080
LIQUIBOOK_URL=https://thaliumx-liquibook:8080
QUANTLIB_URL=https://thaliumx-quantlib:3010

# ===================
# TIMESCALEDB - SSL REQUIRED
# ===================
TIMESCALE_HOST=thaliumx-timescaledb
TIMESCALE_PORT=5432
TIMESCALE_USER=dingir
TIMESCALE_PASSWORD=SET_IN_VAULT  # REQUIRED
TIMESCALE_DB=exchange
TIMESCALE_SSL=true

# ===================
# OPA
# ===================
OPA_URL=https://thaliumx-opa:8181

# ===================
# OBSERVABILITY - SSL
# ===================
OTEL_EXPORTER_OTLP_ENDPOINT=https://thaliumx-otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer SET_IN_VAULT
OTEL_SERVICE_NAME=thaliumx-backend
PROMETHEUS_URL=https://thaliumx-prometheus:9090
GRAFANA_URL=https://thaliumx-grafana:3000
LOKI_URL=https://thaliumx-loki:3100
TEMPO_URL=https://thaliumx-tempo:3200

# ===================
# CORS - Configure for production
# ===================
CORS_ORIGINS=https://app.thaliumx.com,https://admin.thaliumx.com
ALLOWED_ORIGINS=https://app.thaliumx.com,https://admin.thaliumx.com
CORS_CREDENTIALS=true

# ===================
# RATE LIMITING
# ===================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
FINANCIAL_RATE_LIMIT_MAX=20

# ===================
# LOGGING
# ===================
LOG_LEVEL=info
LOG_FORMAT=json

# ===================
# EMAIL (SMTP) - REQUIRED for production
# ===================
SMTP_HOST=SET_IN_VAULT  # REQUIRED - e.g., smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SET_IN_VAULT  # REQUIRED
SMTP_FROM=noreply@thaliumx.com

# ===================
# EXTERNAL SERVICES
# ===================
# Stripe - REQUIRED if processing payments
STRIPE_SECRET_KEY=SET_IN_VAULT
STRIPE_WEBHOOK_SECRET=SET_IN_VAULT

# Twilio - REQUIRED if using SMS
TWILIO_ACCOUNT_SID=SET_IN_VAULT
TWILIO_AUTH_TOKEN=SET_IN_VAULT
TWILIO_PHONE_NUMBER=SET_IN_VAULT

# SendGrid
SENDGRID_API_KEY=SET_IN_VAULT
SENDGRID_FROM_EMAIL=noreply@thaliumx.com
